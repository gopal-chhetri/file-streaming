# =============================================================================
# Self-Hosted Video Streaming Platform: Environment Variables
# =============================================================================
# Copy to .env for local development. In production, inject via Infisical.
# NEVER commit .env: only this .env.example is committed.
# =============================================================================

# App
APP_PORT=3000
NODE_ENV=development
# Comma-separated; "*" can't be used with the credentialed refresh cookie
CORS_ORIGINS=http://streaming.soylab.local

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=password
DB_NAME=streaming
DB_SSL=false

# Redis (Phase 2+)
REDIS_HOST=localhost
REDIS_PORT=6379

# MinIO (Phase 3+)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
MINIO_REGION=us-east-1
# Public endpoint used to build browser-reachable presigned upload URLs
MINIO_PUBLIC_ENDPOINT=localhost
MINIO_PUBLIC_PORT=9000

# Kafka (Phase 4+)
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=file-streaming
KAFKA_GROUP_ID=file-streaming-consumer

# Transcoding Worker: shared secret for the worker's status callbacks.
# Required (no default). Generate with: openssl rand -hex 32
WORKER_API_TOKEN=

# Refresh-token cookie domain (".soylab.local" locally, ".soylab.dpdns.org" in production)
COOKIE_DOMAIN=.soylab.local

# MongoDB (Phase 7+)
MONGO_URI=mongodb://streaming:streaming@localhost:27017/streaming?authSource=admin

# JWT (RS256): base64-encoded PEM keys (or set JWT_PRIVATE_KEY_PATH /
# JWT_PUBLIC_KEY_PATH to PEM files). Without them tokens are signed with a
# throwaway key and every restart logs everyone out; production refuses to start.
# Generate: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt.pem
#           openssl rsa -in jwt.pem -pubout -out jwt.pub
#           base64 -w0 jwt.pem ; base64 -w0 jwt.pub
JWT_PRIVATE_KEY=<base64-encoded-private-key>
JWT_PUBLIC_KEY=<base64-encoded-public-key>
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7

# Casbin (Phase 8): path MUST be env var per RULES.md
# CASBIN_MODEL_PATH=/path/to/model.conf
# CASBIN_POLICY_PATH=/path/to/policy.csv
