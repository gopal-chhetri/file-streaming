# =============================================================================
# Self-Hosted Video Streaming Platform — Environment Variables
# =============================================================================
# Copy to .env for local development. In production, inject via Infisical.
# NEVER commit .env — only this .env.example is committed.
# =============================================================================

# App
APP_PORT=3000
NODE_ENV=development
CORS_ORIGINS=*

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=password
DB_NAME=streaming
DB_SSL=false

# Redis (Phase 2+)
REDIS_HOST=localhost
REDIS_PORT=6379

# MinIO (Phase 3+)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false

# Kafka (Phase 4+)
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=file-streaming
KAFKA_GROUP_ID=file-streaming-consumer

# Transcoding Worker
WORKER_API_TOKEN=internal-worker-token

# MongoDB (Phase 7+)
MONGO_URI=mongodb://streaming:streaming@localhost:27017/streaming?authSource=admin

# JWT (Phase 2) — keys will be managed via Infisical
JWT_PRIVATE_KEY_PATH=<base64-encoded-private-key>
JWT_PUBLIC_KEY_PATH=<base64-encoded-public-key>
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7

# Casbin (Phase 8) — path MUST be env var per RULES.md
# CASBIN_MODEL_PATH=/path/to/model.conf
# CASBIN_POLICY_PATH=/path/to/policy.csv
